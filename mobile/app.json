{
  "expo": {
    "name": "NeuroCare",
    "slug": "neurocare",
    "version": "1.0.0",
    "scheme": "neurocare",
    "orientation": "portrait",
    "icon": "./assets/images/neurocare-logo.png",
    "splash": {
      "image": "./assets/images/neurocare-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F8FC"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ma.neurocare.app"
    },
    "android": {
      "package": "ma.neurocare.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/neurocare-adaptive-icon.png",
        "backgroundColor": "#F5F8FC"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "NeuroCare utilise le micro pour enregistrer la voix de l'aidant qui lira les rappels.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/alarme_rappel.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NeuroCare utilise le micro pour enregistrer la voix de l'aidant et pour poser vos questions à l'Assistant Santé.",
          "speechRecognitionPermission": "NeuroCare transforme votre question parlée en texte pour l'Assistant Santé.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "13bcb36a-f36a-46dc-85bc-e214634db89c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/13bcb36a-f36a-46dc-85bc-e214634db89c"
    }
  }
}
