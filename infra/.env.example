# Copier en .env (jamais commité) et remplacer chaque valeur.
DB_PASSWORD=change-me
MINIO_USER=neurocare
MINIO_PASSWORD=change-me-min-8-chars
AUDIO_INTERNAL_KEY=change-me
# Clé HS256 >= 256 bits, ex. : openssl rand -base64 48
JWT_SECRET=change-me
SPRING_PROFILES_ACTIVE=demo

# Ports hôtes (à changer si déjà occupés sur la machine)
BACKEND_PORT=8080
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# URL de MinIO joignable par les téléphones (URL signées des audios), ex. http://192.168.1.20:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
